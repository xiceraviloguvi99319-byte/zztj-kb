{"volume":"卷008","year_sections":[{"events":[{"desc":"泗川監平围沛公于豐，沛公破之，令雍齒守豐；后引兵之薛，杀泗川守壯于戚","id":"008-二世二年-01","type":"军事","人物":["沛公","泗川監平","雍齒","泗川守壯","左司馬得"],"地点":["豐","薛","戚"]},{"desc":"周章出關屯曹陽，章邯追敗之于澠池，周文自刎","id":"008-二世二年-02","type":"军事","人物":["周章","章邯"],"地点":["曹陽","澠池"]},{"desc":"吳叔圍滎陽不下，田臧矯王令誅吳叔，獻首于陳王，得楚令尹印為上將；后田臧迎秦軍于敖倉戰死，李歸等死滎陽下","id":"008-二世二年-03","type":"军事/內訌","人物":["吳叔","田臧","陳王","李歸","章邯","鄧說","伍逢"],"地点":["滎陽","敖倉","郯","許"]},{"desc":"二世誚讓李斯，李斯上書言督責之術，二世說，行督責益嚴，秦民益駭懼思亂","id":"008-二世二年-04","type":"政治","人物":["二世","李斯"],"论赞人物":["申子","韓非","堯","禹"]},{"desc":"趙李良得秦偽書，殺趙王姊，襲邯鄲殺趙王武臣、邵騷；張耳陳餘獨脫","id":"008-二世二年-05","type":"政治/叛變","人物":["李良","趙王武臣","邵騷","張耳","陳餘"],"地点":["邯鄲","石邑","井陘"]},{"desc":"秦嘉、朱雞石起兵圍東海守于郯；秦嘉不受武平君畔節制，矯王命殺之，自立大司馬","id":"008-二世二年-06","type":"政治/內訌","人物":["秦嘉","朱雞石","武平君畔","陳王"],"地点":["郯"]},{"desc":"二世遣司馬欣董翳佐章邯；章邯殺陳柱國房君、張賀，陳王出監戰","id":"008-二世二年-07","type":"军事","人物":["司馬欣","董翳","章邯","房君","張賀","陳王"]},{"desc":"陳王死于下城父（御莊賈殺之以降）；呂臣起蒼頭軍攻陳殺莊賈，復以陳為楚，葬陳王于碭謚隱王；宋留降秦被車裂","id":"008-二世二年-08","type":"政治/君主之死","人物":["陳王","莊賈","呂臣","宋留"],"地点":["下城父","汝陰","新陽","陳","碭","南陽","武關"]},{"desc":"魏周市招雍齒，雍齒以豐降魏；沛公攻豐不克","id":"008-二世二年-09","type":"军事","人物":["周市","雍齒","沛公"],"地点":["豐","沛"]},{"desc":"張耳陳餘立趙歇為趙王，居信都","id":"008-二世二年-10","type":"政治/立王","人物":["張耳","陳餘","趙歇"],"地点":["信都"]},{"desc":"秦嘉等立景駒為楚王；公孫慶使齊，田儋殺之","id":"008-二世二年-11","type":"政治/立王","人物":["秦嘉","景駒","公孫慶","田儋"],"地点":["方與","定陶"]},{"desc":"黥布（英布）事迹：驪山刑徒亡江中為盜，番君吳芮妻以女，使將兵擊秦；破秦左、右校于青波","id":"008-二世二年-12","type":"人物/军事","人物":["黥布","吳芮"],"地点":["驪山","江","番陽","青波","陳"]},{"desc":"沛公從景駒得張良（拜廄將）；攻碭、下邑，復攻豐不下","id":"008-二世二年-13","type":"军事","人物":["沛公","景駒","張良"],"地点":["留","碭","下邑","豐","蕭","相"]},{"desc":"召平矯陳王令拜項梁為楚上柱國；項梁渡江，陈嬰以兵屬梁","id":"008-二世二年-14","type":"政治/军事","人物":["召平","項梁","陳嬰"],"地点":["廣陵","江","江東","東陽"]},{"desc":"項梁擊殺秦嘉于胡陵，景駒走死；誅敗將朱雞石；沛公拔豐，雍齒奔魏；項羽別攻襄城，拔而坑之","id":"008-二世二年-15","type":"军事","人物":["項梁","秦嘉","景駒","朱雞石","餘樊君","沛公","雍齒","項羽"],"地点":["下邳","彭城","胡陵","栗","薛","豐","襄城"]},{"desc":"范增說項梁立楚懷王孫心為楚懷王，都盱眙；項梁自號武信君；張良說立韓成為韓王","id":"008-二世二年-16","type":"政治/立王","人物":["范增","項梁","楚懷王心","陳嬰","張良","韓成"],"地点":["盱眙","薛","穎川"],"论赞人物":["楚南公","懷王"]},{"desc":"章邯破齊楚魏軍于臨濟，殺齊王儋、周市；魏王咎自燒殺；魏豹走楚；田榮立田市為齊王","id":"008-二世二年-17","type":"军事","人物":["章邯","齊王儋","周市","項它","魏王咎","魏豹","田榮","田假","田角","田間","田市","田橫"],"地点":["臨濟","東阿","亢父","城陽","濮陽","定陶"]},{"desc":"趙高專權始末：勸二世深居、設阱陷李斯、三請不見；李斯上書言趙高之短不納；馮去疾馮劫諫被下獄自殺；李斯具五刑腰斬咸陽，夷三族；趙高為丞相","id":"008-二世二年-18","type":"政治/權鬥","人物":["趙高","二世","李斯","李由","馮去疾","馮劫"],"地点":["咸陽","三川","阿房宮","上蔡"],"论赞人物":["田常","齊簡公"]},{"desc":"項梁死于定陶（章邯大破楚軍）；宋義使齊道遇高陵君顯論武信君必敗；懷王徙都彭城，立魏豹為魏王，并軍封侯","id":"008-二世二年-19","type":"军事/政治","人物":["項梁","章邯","宋義","高陵君顯","項羽","沛公","呂臣","楚懷王","魏豹"],"地点":["定陶","雍丘","東阿","外黃","陳留","彭城","盱眙","碭"]},{"concurrent_with":["008-二世二年-19"],"desc":"章邯渡河擊趙，徙邯鄲民河內；王離圍趙王歇張耳于巨鹿；陳餘軍巨鹿北不敢進；懷王以宋義為上將軍（卿子冠軍）救趙，約先入關中者王之，遣沛公西略地","id":"008-二世二年-20","type":"军事","人物":["章邯","王離","趙王歇","張耳","陳餘","宋義","項羽","范增","沛公"],"地点":["邯鄲","河內","巨鹿","棘原","常山","關中","陽城","槓里"]}],"year_bce":-208,"year_ganzhi":"癸巳","year_label":"二世二年"},{"events":[{"desc":"齊將田都畔田榮助楚救趙","id":"008-二世三年-01","type":"政治","人物":["田都","田榮"]},{"desc":"沛公攻破東郡尉于成武","id":"008-二世三年-02","type":"军事","人物":["沛公"],"地点":["成武","東郡"]},{"desc":"項羽于安陽帳中斬宋義，自立為假上將軍，懷王因使為上將軍","id":"008-二世三年-03","type":"政治/軍事政變","人物":["項羽","宋義","宋襄","桓楚","楚懷王"],"地点":["安陽","無鹽"]},{"desc":"沛公至栗奪剛武侯軍，與魏將皇欣武滿合破秦軍","id":"008-二世三年-04","type":"军事","人物":["沛公","剛武侯","皇欣","武滿"],"地点":["栗"]},{"concurrent_with":["008-二世三年-03","008-二世三年-04"],"desc":"巨鹿之戰：項羽沈船破釜，九戰大破秦軍，殺蘇角虜王離，涉間自燒；諸侯膝行而前，項羽始為諸侯上將軍；張耳陳餘失和（印綬事）","id":"008-二世三年-05","type":"军事/決戰","人物":["項羽","王離","蘇角","涉間","章邯","當陽君","蒲將軍","陳餘","張耳","張黶","陳澤","張敖","齊王安"],"地点":["巨鹿","河","棘原"]},{"desc":"沛公西進：遇彭越于昌邑；高陽得酈食其（號廣野君）下陳留；戰白馬曲遇破楊熊；南攻穎川屠之；陳恢說降南陽守齮（封殷侯）；至丹水降高武侯鰓襄侯王陵；偕梅鋗下析酈","id":"008-二世三年-06","type":"军事","人物":["沛公","彭越","酈食其","酈商","張良","楊熊","韓王成","司馬卬","南陽守齮","陳恢","高武侯鰓","襄侯王陵","梅鋗"],"地点":["昌邑","巨野澤","高陽","陳留","開封","白馬","曲遇","滎陽","穎川","平陰","洛陽","轘轅","陽翟","犨","宛","南陽","丹水","胡陽","析","酈"]},{"concurrent_with":["008-二世三年-05"],"desc":"章邯降楚：司馬欣見趙高不用，陈餘遺書說降；項羽破秦軍汙水，盟于洹水，立章邯為雍王，司馬欣為上將軍將秦軍前行","id":"008-二世三年-07","type":"政治/軍事投降","人物":["章邯","司馬欣","趙高","陳餘","項羽","蒲將軍","申陽","候始成"],"地点":["棘原","漳南","咸陽","三戶","汙水","洹水","殷虛","瑕丘","河南"],"论赞人物":["白起","蒙恬"]},{"desc":"趙高指鹿為馬；沛公屠武關；趙高弑二世于望夷宮（閻樂行事），立子嬰為秦王；子嬰齋五日刺殺趙高于齋宮，三族其家；沛公用張良計繞嶢關逾蕢山，大破秦軍藍田","id":"008-二世三年-08","type":"政治/弑君","人物":["趙高","二世","閻樂","趙成","子嬰","沛公","張良","酈食其","陸賈"],"地点":["望夷宮","咸陽","宜春苑","社南","武關","嶢關","蕢山","藍田","涇水"]}],"year_bce":-207,"year_ganzhi":"甲午","year_label":"二世三年"}],"years_count":2}