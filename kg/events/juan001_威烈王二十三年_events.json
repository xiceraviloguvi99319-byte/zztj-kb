{"events":[{"desc":"周威烈王命晋大夫魏斯、赵籍、韩虔为诸侯（三家分晋合法化）","id":"001-W23-01","related_lunzans":["臣光论礼：名分之坏"],"type":"政治/分封","人物":["魏斯","赵籍","韩虔"]},{"desc":"智宣子欲立瑶为后，智果以'才胜德'谏，不听；智果别族为辅氏","id":"001-W23-02","type":"政治/继承","人物":["智宣子","智瑶","智果","智宵"]},{"desc":"赵简子择后：伯鲁失简、无恤守简，立无恤（赵襄子）；使尹铎治晋阳、宽民","id":"001-W23-03","type":"政治/继承","人物":["赵简子","赵伯鲁","赵无恤","尹铎"],"地点":["晋阳"]},{"desc":"智伯向韩康子、魏桓子索地（各得万家之邑），向赵襄子索蔺、皋狼之地被拒","id":"001-W23-04","type":"政治/外交","人物":["智伯","韩康子","魏桓子","赵襄子","段规","任章"],"地点":["蔺","皋狼"]},{"desc":"智伯帅韩魏之甲攻赵，赵襄子走晋阳；三家围而灌之，城不浸者三版","id":"001-W23-05","type":"军事/围攻","人物":["智伯","赵襄子"],"地点":["晋阳"]},{"concurrent_with":["001-W23-05"],"desc":"韩魏倒戈：张孟谈密约韩魏，决水灌智伯军，杀智伯、尽灭智氏之族（唯辅果在）","id":"001-W23-06","type":"军事/政变","人物":["张孟谈","韩康子","魏桓子","赵襄子","智伯"]},{"desc":"豫让为智伯报仇，两次刺杀赵襄子未遂被杀","id":"001-W23-07","type":"政治/复仇","人物":["豫让","赵襄子"]},{"desc":"赵襄子卒后赵氏内乱：桓子逐浣自立一年卒，国人杀其子复迎浣，是为献子；传籍（烈侯）","id":"001-W23-08","type":"政治/继承","人物":["赵襄子","赵桓子","赵浣","赵籍"]},{"desc":"魏文侯师卜子夏田子方、式段干木之庐；拒韩赵借师，韩赵皆朝于魏，魏始大于三晋","id":"001-W23-09","type":"政治/任用","人物":["魏文侯","卜子夏","田子方","段干木"]},{"desc":"魏使乐羊伐中山，克之，以封其子击","id":"001-W23-10","type":"军事","人物":["乐羊","魏击"],"地点":["中山"]},{"desc":"李克举魏成为相（五举之辨：魏成得三师 vs 翟璜进五臣）","id":"001-W23-11","type":"政治/任用","人物":["李克","魏成","翟璜","吴起","西门豹"]},{"desc":"吴起杀妻求将破齐师，奔魏为将，击秦拔五城","id":"001-W23-12","type":"军事/人物","人物":["吴起","魏文侯","李克","曾参"]},{"desc":"燕湣公薨，子僖公立","id":"001-W23-13","type":"政治/继位","人物":["燕湣公","燕僖公"]}],"volume":"卷001","year_bce":-403,"year_ganzhi":"戊寅","year_label":"威烈王二十三年"}