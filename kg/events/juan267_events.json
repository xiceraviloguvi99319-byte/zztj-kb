{"id":"267-開平三年-60","desc":"劉守光圍滄州久不下，城中食盡民食堇泥軍士食人，呂兗選羸弱者烹之給軍食謂之宰殺務","type":"軍事","人物":["劉守光","劉守文","呂兗"],"地点":["滄州"]},
{"id":"267-開平四年-01","desc":"春正月劉延祚力盡出降；守光使張萬進周知裕輔繼威鎮滄州，族呂兗釋孫鶴；呂琦得門客趙玉救免，後為代州判官","type":"軍事","人物":["劉延祚","劉守光","張萬進","周知裕","劉繼威","呂兗","呂琦","趙玉","晉王"],"地点":["滄州","幽州","代州"]},
{"id":"267-開平四年-02","desc":"以盧光稠為鎮南留後","type":"政治","人物":["盧光稠"],"地点":[]},
{"id":"267-開平四年-03","desc":"劉守光為其父仁恭請致仕以為太師，尋使人潛殺其兄守文歸罪殺者而誅之","type":"政治","人物":["劉守光","劉仁恭","劉守文"],"地点":[]},
{"id":"267-開平四年-04","desc":"二月萬全感自岐歸廣陵，岐王承製加弘農王兼中書令嗣吳王，吳王赦其境內","type":"政治","人物":["萬全感","岐王","弘農王"],"地点":["廣陵"]},
{"id":"267-開平四年-05","desc":"高澧求救於吳，湖州將盛師友沈行思閉城不內；澧帥麾下五千人奔吳；吳越王鏐巡湖州以錢鏢為刺史","type":"政治","人物":["高澧","盛師友","沈行思","吳越王鏐","錢鏢"],"地点":["湖州"]},
{"id":"267-開平四年-06","desc":"蜀太子宗懿驕暴與內樞密使唐道襲有隙，蜀主以道襲為山南西道節度使同平章事；道襲薦鄭頊為內樞密使，復出頊為果州刺史以潘炕代之","type":"政治","人物":["太子宗懿","唐道襲","蜀主","鄭頊","潘炕"],"地点":[]},
{"id":"267-開平四年-07","desc":"夏州都指揮使高宗益作亂殺節度使李彝昌，將吏共誅宗益推李仁福為帥；以仁福為定難節度使","type":"政治","人物":["高宗益","李彝昌","李仁福"],"地点":["夏州"]},
{"id":"267-開平四年-08","desc":"宋州節度使衡王友諒獻瑞麥，帝以宋州大水詰責之，以惠王友能代為宋州留後","type":"政治","人物":["衡王友諒","帝","惠王友能"],"地点":["宋州"]},
{"id":"267-開平四年-09","desc":"以晉絳沁三州為定昌軍，以華溫琪為節度使","type":"政治","人物":["華溫琪","冀王友謙"],"地点":["晉州","絳州","沁州"]},
{"id":"267-開平四年-10","desc":"左金吾大將軍寇彥卿入朝於天津橋殺人闕下，御史司憲崔沂劾奏，帝責授彥卿游擊將軍左衛中郎將","type":"政治","人物":["寇彥卿","帝","崔沂"],"地点":[]},
{"id":"267-開平四年-11","desc":"五月吳徐溫母周氏卒，溫以偶人祭卻以衣衣貧者；未幾起復為內外馬步軍都軍使領潤州觀察使","type":"政治","人物":["徐溫","周氏"],"地点":["潤州"]},
{"id":"267-開平四年-12","desc":"岐王屢求貨於蜀蜀主皆與之，又求巴劍二州不許乃復以絲茶布帛七萬遺之","type":"外交","人物":["岐王","蜀主"],"地点":[]},
{"id":"267-開平四年-13","desc":"以劉繼威為義昌節度使","type":"政治","人物":["劉繼威"],"地点":[]},
{"id":"267-開平四年-14","desc":"天雄節度使兼中書令鄴貞莊王羅紹威卒，詔以其子周翰為天雄留後","type":"政治","人物":["羅紹威","周翰"],"地点":[]},
{"id":"267-開平四年-15","desc":"匡國節度使長樂忠敬王馮行襲疾篤，帝命李珽馳往許州諭將吏；行襲卒，以李珽權知匡國留後，冒馮姓者皆還宗","type":"政治","人物":["馮行襲","帝","李珽"],"地点":["許州"]},
{"id":"267-開平四年-16","desc":"楚王殷求為天策上將詔加天策上將軍，始開天策府以弟賨為左相存為右相；遣將侵荊南為高季昌擊破斬首五千級","type":"軍事","人物":["楚王殷","高季昌"],"地点":["荊南","油口","白田"]},
{"id":"267-開平四年-17","desc":"吳水軍指揮使敖駢圍彭玕弟瑊於赤石，楚兵救瑊虜駢以歸","type":"軍事","人物":["敖駢","彭玕","彭瑊"],"地点":["赤石"]},
{"id":"267-開平四年-18","desc":"秋七月蜀門下侍郎兼吏部尚書同平章事韌城卒","type":"政治","人物":["韌城"],"地点":[]},
{"id":"267-開平四年-19","desc":"吳越王鏐表乞原宦者周延誥等二十五人，上諭留於彼","type":"政治","人物":["吳越王鏐","周延誥"],"地点":[]},
{"id":"267-開平四年-20","desc":"岐王與邠涇二帥告晉請合兵攻李仁福，晉王遣周德威會之合五萬眾圍夏州","type":"軍事","人物":["岐王","晉王","周德威","李仁福"],"地点":["夏州"]},
{"id":"267-開平四年-21","desc":"八月以劉守光兼義昌節度使","type":"政治","人物":["劉守光"],"地点":[]},
{"id":"267-開平四年-22","desc":"鎮定不輸常賦而貢獻甚勤，帝聞趙王鎔潛與晉通深然鎮定難制","type":"政治","人物":["帝","趙王鎔"],"地点":[]},
{"id":"267-開平四年-23","desc":"李仁福告急，以張宗奭為西京留守，李思安為東北面行營都指揮使屯河陽；帝發洛陽至陝，以楊師厚為西路行營招討使會康懷貞屯三原；遣李遇劉綰自鄜延趨銀夏邀歸路","type":"軍事","人物":["李仁福","張宗奭","李思安","帝","楊師厚","康懷貞","李遇","劉綰"],"地点":["河陽","陝","三原"]},
{"id":"267-開平四年-24","desc":"吳越王鏐築捍海石唐廣杭州城，由是錢唐富庶盛於東南","type":"經濟","人物":["吳越王鏐"],"地点":["杭州","錢唐"]},
{"id":"267-開平四年-25","desc":"九月上發陝至洛陽疾復作","type":"政治","人物":["上"],"地点":["洛陽"]},
{"id":"267-開平四年-26","desc":"李遇等至夏州，岐晉兵皆解去","type":"軍事","人物":["李遇"],"地点":["夏州"]},
{"id":"267-開平四年-27","desc":"冬十月遣楊師厚李思安將兵屯澤州以圖上黨","type":"軍事","人物":["楊師厚","李思安"],"地点":["澤州","上黨"]},
{"id":"267-開平四年-28","desc":"沈行思恨吳越王鏐賣己，取鍛槌殺陳瑰欲刺盛師友，鏐斬行思以師友為婺州刺史","type":"政治","人物":["沈行思","吳越王鏐","陳瑰","盛師友"],"地点":["湖州","婺州"]},
{"id":"267-開平四年-29","desc":"十一月以王景仁充北面行營都指揮招討使、韓勍副之、李思安為先鋒將趣上黨；尋遣景仁等屯魏州","type":"軍事","人物":["王景仁","韓勍","李思安"],"地点":["上黨","魏州"]},
{"id":"267-開平四年-30","desc":"蜀主更太子宗懿名曰元坦；立假子宗裕等為通王夔王昌王嘉王集王，立其子宗仁等為普王雅王褒王榮王興王彭王信王鄭王","type":"政治","人物":["蜀主","太子宗懿"],"地点":[]},
{"id":"267-開平四年-31","desc":"上疾小愈校獵於伊洛之間","type":"政治","人物":["上"],"地点":[]},
{"id":"267-開平四年-32","desc":"上疑趙王鎔貳於晉欲除移鎮定，遣杜廷隱丁延徽分屯深冀；石公立諫鎔開門揖盜","type":"政治","人物":["上","趙王鎔","杜廷隱","丁延徽","石公立"],"地点":["深州","冀州"]},
{"id":"267-開平四年-33","desc":"廷隱等閉門盡殺趙戍兵據深冀；鎔求援於燕晉；晉王會將佐決意救趙遣周德威出井陘屯趙州；守光不肯出兵；鎮定復稱唐天祐年號復以武順為成德軍","type":"政治","人物":["趙王鎔","晉王","周德威","燕王守光","王處直","孫鶴"],"地点":["真定","晉陽","趙州","幽州"]},
{"id":"267-開平四年-34","desc":"司天言太陰虧不利宿兵，上召王景仁等還洛陽；聞趙晉合命景仁等將兵擊之，自河陽渡河會羅周翰兵軍於邢洺","type":"軍事","人物":["上","王景仁","羅周翰"],"地点":["洛陽","趙州","邢州","洺州"]},
{"id":"267-開平四年-35","desc":"盧光稠卒其子延昌來奔喪，譚全播立而事之；延昌受吳拜為虔州刺史又密表於梁；以延昌為鎮南留後；嚴可求請置制置使於新淦圖虔州","type":"政治","人物":["盧光稠","盧延昌","譚全播","楚王殷","嚴可求","廖爽"],"地点":["虔州","韶州","新淦"]},
{"id":"267-開平四年-36","desc":"蜀主以御史中丞周庠、戶部侍郎判度支庾傳素並為中書侍郎同平章事","type":"政治","人物":["蜀主","周庠","庾傳素"],"地点":[]},
{"id":"267-開平四年-37","desc":"太常卿李燕等刊定梁律令格式行之","type":"政治","人物":["李燕"],"地点":[]},
{"id":"267-開平四年-38","desc":"王景仁等進軍柏鄉","type":"軍事","人物":["王景仁"],"地点":["柏鄉"]},
{"id":"267-開平四年-39","desc":"蜀大赦改明年元曰永平","type":"政治","人物":[],"地点":[]},
{"id":"267-開平四年-40","desc":"趙王鎔復告急於晉，晉王以李存審守晉陽自將救趙至趙州；兩軍柏鄉對峙，周德威以精騎擊梁軍兩端俘獲百餘人","type":"軍事","人物":["趙王鎔","晉王","李存審","周德威","王處直","王景仁","韓勍","李存璋"],"地点":["趙州","柏鄉","野河"]},
{"id":"267-開平四年-41","desc":"德威諫晉王按兵待衰，勸退保高邑誘賊離營；晉王從之拔營退保高邑","type":"軍事","人物":["周德威","晉王","張承業"],"地点":["高邑"]},
{"id":"267-開平四年-42","desc":"辰州蠻酋宋鄴寇湘鄉、漵州蠻酋潘金盛寇武岡，楚王殷遣呂師周將衡山兵五千討之","type":"軍事","人物":["宋鄴","潘金盛","楚王殷","呂師周"],"地点":["湘鄉","武岡"]},
{"id":"267-開平四年-43","desc":"寧遠節度使龐巨昭、高州防禦使劉昌魯致書請自歸於楚；楚王殷遣姚彥章迎之，巨昭殺莫彥昭舉州迎降","type":"政治","人物":["龐巨昭","劉昌魯","楚王殷","姚彥章","莫彥昭","劉隱"],"地点":["容州","高州","長沙"]},
{"id":"267-乾化元年-01","desc":"春正月丙戌朔日有食之","type":"災異","人物":[],"地点":[]},
{"id":"267-乾化元年-02","desc":"柏鄉對峙：梁兵刈芻自給晉人抄之；周德威與史建瑭李嗣源壓梁壘門，景仁韓勍悉眾而出轉戰至高邑南；李存璋陳野河上，李建及力戰卻之；德威諫晉王勞逸制之王乃止","type":"軍事","人物":["周德威","史建瑭","李嗣源","王景仁","韓勍","李存璋","李建及","晉王"],"地点":["柏鄉","高邑","野河"]},
{"id":"267-乾化元年-03","desc":"柏鄉大戰：梁軍未食士無鬥志，德威呼梁兵走矣晉兵爭進，梁兵大潰；斬首二萬級，龍驤神捷精兵殆盡；景仁韓勍李思安以數十騎走；杜廷隱等棄深冀驅丁壯為奴婢坑老弱","type":"軍事","人物":["周德威","李嗣源","李存璋","王景仁","韓勍","李思安","晉王","杜廷隱","王檀"],"地点":["柏鄉","野河","邢州","趙州"]},
{"id":"267-乾化元年-04","desc":"復以楊師厚為北面都招討使屯河陽收集散兵得萬人；晉王遣德威建瑭趣澶魏、承業存璋攻邢州；帝遣徐仁溥助王檀守邢州；罷王景仁招討使落平章事","type":"軍事","人物":["楊師厚","晉王","周德威","史建瑭","張承業","李存璋","帝","徐仁溥","王檀","王景仁"],"地点":["河陽","澶州","魏州","邢州"]},
{"id":"267-乾化元年-05","desc":"蜀主之女普慈公主嫁岐王從子繼崇，公主求歸成都蜀主留之以宋光嗣為閣門南院使，岐王怒始與蜀絕","type":"外交","人物":["蜀主","普慈公主","繼崇","宋光嗣","岐王"],"地点":["成都"]},
{"id":"267-乾化元年-06","desc":"呂師周引兵入飛山洞襲潘金盛擒送武岡斬之，移兵擊宋鄴","type":"軍事","人物":["呂師周","潘金盛","宋鄴"],"地点":["飛山洞","武岡"]},
{"id":"267-乾化元年-07","desc":"二月晉王至魏州攻之不克；上以李振為天雄節度副使命杜廷隱衛之夜入魏州助周翰城守；晉王觀河於黎陽梁兵棄舟而去","type":"軍事","人物":["晉王","上","李振","杜廷隱","羅周翰"],"地点":["魏州","黎陽"]},
{"id":"267-乾化元年-08","desc":"蔡州右廂指揮使劉行琮作亂將奔淮南，順化指揮使王存儼誅行琮自領州事；帝召還博王友文討兵，授存儼權知蔡州事","type":"政治","人物":["帝","張慎思","劉行琮","王存儼","博王友文"],"地点":["蔡州","洛陽","鄢陵"]},
{"id":"267-乾化元年-09","desc":"周德威自臨清攻貝州拔夏津高唐，攻博州拔東武朝城，攻澶州刺史張可臻棄城走帝斬之；進攻黎陽拔臨河淇門逼衛州；帝帥親軍屯白司馬阪備之","type":"軍事","人物":["周德威","張可臻","帝"],"地点":["貝州","夏津","高唐","博州","澶州","黎陽","衛州","白司馬阪"]},
{"id":"267-乾化元年-10","desc":"燕王守光既克滄州淫虐滋甚，欲為四鎮盟主；晉王笑其愚，諸將請先取守光王曰善；楊師厚救邢魏晉解圍去","type":"政治","人物":["燕王守光","趙王鎔","王處直","晉王","楊師厚"],"地点":["滄州","邢州","魏州"]},
{"id":"267-乾化元年-11","desc":"趙王鎔自來謁晉王於趙州，遣其養子德明將三十七都常從晉王征討；晉王發趙州歸晉陽留周德威等戍趙州","type":"政治","人物":["趙王鎔","晉王","德明","周德威"],"地点":["趙州","晉陽"]}
]}
